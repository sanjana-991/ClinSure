# ClinSure Backend — Environment Variables
# Copy this file to .env and fill in the values for your environment.

# Comma-separated list of allowed frontend origins.
# Local development defaults are already built into config.py, so this
# variable only needs to be set in production (Render).
#
# Example for production:
#   ALLOWED_ORIGINS=https://your-clinsure-app.vercel.app
#
# Example for local + production:
#   ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-clinsure-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional: Override the default artifacts directory path.
# Defaults to the "artifacts/" folder next to main.py.
# MODEL_DIR=/path/to/your/artifacts
